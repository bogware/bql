<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bogware.Bql</RootNamespace>
    <PackageId>Bogware.Bql</PackageId>
    <Description>BQL: a pipe-based query language and streaming engine for any row source, with SPL-compatible search syntax.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bogware.Bql.Natural" />
    <InternalsVisibleTo Include="Bogware.Bql.Tests" />
  </ItemGroup>

</Project>
